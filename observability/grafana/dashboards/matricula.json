          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"self-healing-matricula-(gateway|students|courses|enrollment|billing|postgres)-[0-9]+\"}[30s])) / on (name) (sum by (name) (container_spec_cpu_quota{name=~\"self-healing-matricula-(gateway|students|courses|enrollment|billing|postgres)-[0-9]+\"}) / on (name) sum by (name) (container_spec_cpu_period{name=~\"self-healing-matricula-(gateway|students|courses|enrollment|billing|postgres)-[0-9]+\"}))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latencia p95 (ms)",
      "description": "Percentil 95 de las peticiones de negocio.",
      "datasource": {
        "type": "prometheus",
